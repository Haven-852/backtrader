# ==================== 大模型 API 配置 ====================
# 复制本文件为 backend/.env 后填入真实值（勿提交 .env）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=qwen3:8b

ANTHROPIC_API_KEY=
GROK_API_KEY=

# ==================== 数据源 Token 配置 ====================
# Tushare Pro - 国内股票/期货/基本面数据主力来源
# ==================== Tushare Pro 多Token分级配置 ====================
# 每个独立权限模块使用独立Token接口

# 基础行情 (日线/周线/月线/复权因子)
TUSHARE_TOKEN_BASIC=

# 分钟行情 (stk_mins 高频)
TUSHARE_TOKEN_MINS=

# 财务基本面 (三大表+指标)
TUSHARE_TOKEN_FINANCIAL=

# 资金行为 (moneyflow/top_list/margin/block_trade)
TUSHARE_TOKEN_FLOW=

# 指数 (index_basic/daily/weight)
TUSHARE_TOKEN_INDEX=

# 基金ETF (fund_basic/nav/daily/portfolio)
TUSHARE_TOKEN_FUND=

# 新闻公告 (news/major_news/anns)
TUSHARE_TOKEN_NEWS=

# 研报 (broker_reports)
TUSHARE_TOKEN_REPORT=

# 通用兜底 Token (兼容旧版)
TUSHARE_TOKEN=

# FRED - 宏观经济数据 (GDP, CPI, 利率等)
FRED_API_KEY=

# ==================== 数据库配置 ====================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=quant
POSTGRES_PASSWORD=
POSTGRES_DB=backtrader

INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=
INFLUX_ORG=quant
INFLUX_BUCKET=market_data

REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# ==================== 项目配置 ====================
DEBUG=true
ENV=development
FRONTEND_PORT=5173
BACKEND_PORT=8000

# 注意：所有需要 Token 的地方都从这里读取
# 规则延续：后续所有数据源、API 均必须从 .env 读取，不得硬编码

# Datahubco OpenAPI
DATAHUBCO_API_KEY=
DATAHUBCO_BASE_URL=http://datahubco.com/app-api/openapi/v1/tushare

# ==================== 模拟交易持仓告警推送（任选其一或多项） ====================
# 企业微信群机器人 Webhook
WECOM_BOT_WEBHOOK=
# 企业微信智能机器人长连接
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
# 给机器人发过消息后写入。单聊填 userid，群聊填 chatid
WECOM_AIBOT_CHATID=
WECOM_AIBOT_CHAT_TYPE=2
# PushPlus：https://www.pushplus.plus
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
# 通用 Webhook（POST JSON: title/content/source/ts）
ALERT_WEBHOOK_URL=
